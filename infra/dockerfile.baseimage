FROM python:3.12.8

WORKDIR /app

ENV PYTHONPATH=/app

RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    tesseract-ocr \
    poppler-utils \
    pkg-config \
    libcairo2-dev \
    libgirepository1.0-dev \
    curl \
    unzip \
    ca-certificates \
    bzip2 \
    && rm -rf /var/lib/apt/lists/*

# Install Deno v2.5.6
RUN mkdir -p /app/bin && \
    cd /tmp && \
    curl -LOJ https://github.com/denoland/deno/releases/download/v2.5.6/deno-x86_64-unknown-linux-gnu.zip && \
    unzip deno-x86_64-unknown-linux-gnu.zip && \
    mv deno /app/bin/deno && \
    chmod a+x /app/bin/deno && \
    rm deno-x86_64-unknown-linux-gnu.zip

ENV PATH="/app/bin:$PATH"

# Install Pyodide 0.29.0 with required packages
RUN cd /app && \
    curl -LOJ https://github.com/pyodide/pyodide/releases/download/0.29.0/pyodide-0.29.0.tar.bz2 && \
    tar xf pyodide-0.29.0.tar.bz2 && \
    rm pyodide-0.29.0.tar.bz2

COPY pyproject.toml ./
COPY README.md ./
COPY LICENSE ./

RUN pip install --no-cache-dir -U pip setuptools wheel

# Copy patched Pyodide sandbox runtime (fixes \n escaping & chardet version pin)
COPY infra/data/sandbox/main.ts /app/data/sandbox/main.ts
ENV PYODIDE_SANDBOX_PKG=/app/data/sandbox/main.ts

# Build wheels for Pyodide packages
# Pin chardet<6: requests 2.x only supports chardet 3.x-5.x;
# without the pin, micropip would install the latest (6.x) from PyPI,
# triggering RequestsDependencyWarning at runtime.
RUN pip wheel -w /app/pyodide dill "chardet<6"

# Install dependencies in stages to avoid resolution-too-deep error
RUN pip install --no-cache-dir -e ".[cli]"
RUN pip install --no-cache-dir -e ".[runtime]"
RUN pip install --no-cache-dir -e ".[tools]"
RUN pip install --no-cache-dir -e ".[community]"

# ═══════════════════════════════════════════════════════════════════════════════
# TEST DEPENDENCIES
# ═══════════════════════════════════════════════════════════════════════════════
# Pre-installed for CI performance. These packages are used by:
#   - .github/workflows/execute-tests-on-pr.yml (unit-tests job)
#   - .github/workflows/test-runner-reusable.yml (toolkit tests)
#
# After building this image, the workflow steps that install these packages
# can be removed or kept as no-ops (pip will skip already-installed packages).
# ═══════════════════════════════════════════════════════════════════════════════

# pytest: Test framework and plugins
RUN pip install --no-cache-dir \
    pytest \
    pytest-timeout \
    pytest-dotenv

# deepeval: LLM evaluation metrics for document loader tests
RUN pip install --no-cache-dir "deepeval>=3.4.6"

# testcontainers: Docker-based integration tests (e.g., pgvector)
# Note: Requires Docker socket access at runtime (-v /var/run/docker.sock:/var/run/docker.sock)
RUN pip install --no-cache-dir "testcontainers==4.14.2"
